static std::string buildResponse(const std::string& status, const std::string& contentType, const std::string& body)
{
    std::ostringstream oss;
    oss << "HTTP/1.1 " << status << "\r\n";
    oss << "Content-Type: " << contentType << "\r\n";
    oss << "Content-Length: " << body.size() << "\r\n";
    oss << "Connection: close\r\n";
    oss << "\r\n";
    oss << body;
    return oss.str();
}

std::string Client::generateResponse(Connection& conn)
{
    std::string response;
    std::string getMeth;
    getMeth = conn.request.getMethod();
    if (getMeth == "GET")
    {
        std::string reqPath = conn.request.getPath();
        if (reqPath.empty() || reqPath == "/")
            reqPath = "/index.html";

        std::string filePath = "www/html" + reqPath;
        std::ifstream file(filePath.c_str(), std::ios::in | std::ios::binary);
        if (!file)
        {
            std::string body = "<html><body><h1>404 Not Found</h1></body></html>";
            return buildResponse("404 Not Found", "text/html", body);
        }

        std::ostringstream bodyStream;
        bodyStream << file.rdbuf();
        response = buildResponse("200 OK", "text/html", bodyStream.str());
    }
    else if (getMeth == "POST")
    {
        std::string body = "<html><body><h1>POST request received</h1></body></html>";
        response = buildResponse("200 OK", "text/html", body);
    }
    else if (getMeth == "DELETE")
    {
        std::string body = "<html><body><h1>DELETE request received</h1></body></html>";
        response = buildResponse("200 OK", "text/html", body);
    }
    else
    {
        response = buildResponse("405 Method Not Allowed", "text/plain", "");
    }
    
    return response;
}