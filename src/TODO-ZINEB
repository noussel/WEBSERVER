bool Server::shouldCloseConnection(Connection& conn) {
    std::map<std::string, std::string> headers = conn.request.getHeader();
    std::map<std::string, std::string>::const_iterator it = headers.find("Connection");
    
    // If client explicitly asked to close, close it
    if (it != headers.end() && it->second == "close")
        return true;
    
    // If client asked for keep-alive, keep it open
    if (it != headers.end() && it->second == "keep-alive")
        return false;
    
    // Default: HTTP/1.1 keep-alive, HTTP/1.0 close
    if (conn.request.getVersion() == "HTTP/1.1")
        return false;  // Keep open
    else
        return true;   // Close
}



